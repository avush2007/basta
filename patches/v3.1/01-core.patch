--- a/scripts/copy-vendor.mjs
+++ b/scripts/copy-vendor.mjs
@@ -0,0 +1,15 @@
+import fs from 'node:fs';
+import path from 'node:path';
+const out=path.resolve('www/vendor');
+fs.mkdirSync(out,{recursive:true});
+const copies=[
+  ['node_modules/@supabase/supabase-js/dist/umd/supabase.js','supabase.js'],
+  ['node_modules/html2canvas/dist/html2canvas.min.js','html2canvas.min.js'],
+  ['node_modules/jspdf/dist/jspdf.umd.min.js','jspdf.umd.min.js'],
+  ['node_modules/html5-qrcode/html5-qrcode.min.js','html5-qrcode.min.js']
+];
+for(const [src,name] of copies){
+  if(!fs.existsSync(src)) throw new Error(`Missing vendor file: ${src}`);
+  fs.copyFileSync(src,path.join(out,name));
+}
+console.log('Native vendor assets copied into www/vendor');
